# ============================================================
# GRADE UP 환경변수 템플릿
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 절대 커밋하지 마세요 (.gitignore 에 포함됨)
# ============================================================

# ---------- Firebase 클라이언트 설정 (공개 가능 — 브라우저에 노출됨) ----------
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것) ----------
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 (JSON 다운로드)
# JSON 의 project_id / client_email / private_key 값을 넣으세요.
# private_key 는 줄바꿈이 \n 으로 이스케이프된 한 줄 문자열로 넣습니다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# ---------- Anthropic API (서버 전용 — 클라이언트 노출 절대 금지) ----------
ANTHROPIC_API_KEY=
